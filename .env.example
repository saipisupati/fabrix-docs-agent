# Copy to .env and fill in values (.env is gitignored)

# Required for local path (OpenRouter embed + OpenAI generate)
OPENROUTER_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Doc source paths (required for ingest; no defaults in repo)
BOTS_DIR=/path/to/docs-export/Bots
DOCS_ROOT=/path/to/docs-export
CFXQL_FILE=/path/to/docs-export/reference_guides/cfxql.md

# Local path defaults (leave REMOTE_BASE_URL unset)
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
COLLECTION_NAME=fabrix_docs

# Remote retrieval path (fastembed wrapper port, not raw Qdrant 6333)
# When set, query embeds server-side via POST {REMOTE_BASE_URL}/search
# REMOTE_BASE_URL=http://<remote_host>:8000
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# COLLECTION_NAME=fabrix_docs_remote

# Optional API / docs site
# DOCS_SITE_ORIGIN=https://docs.fabrix.ai
# API_KEY=your-secret-key
